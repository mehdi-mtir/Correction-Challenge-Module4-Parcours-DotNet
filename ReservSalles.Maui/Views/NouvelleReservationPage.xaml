<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReservSalles.Maui.ViewModels"
             x:Class="ReservSalles.Maui.Views.NouvelleReservationPage"
             x:DataType="vm:NouvelleReservationViewModel"
             Title="Nouvelle réservation"
             BackgroundColor="{StaticResource RsFond}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10" MaximumWidthRequest="600">
            <Label Text="{Binding Salle.Nom, StringFormat='Salle {0}'}" FontSize="22"
                   FontAttributes="Bold" TextColor="{StaticResource RsPrimaire}" />
            <Label Text="{Binding Salle.CapaciteTexte, StringFormat='Capacité : {0}'}"
                   TextColor="{StaticResource RsTexteSecondaire}" />

            <Label Text="Objet" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry Text="{Binding Objet}" Placeholder="De 3 à 80 caractères" MaxLength="80" />

            <Label Text="Date" FontAttributes="Bold" />
            <DatePicker Date="{Binding Date}" MinimumDate="{Binding DateMin}" Format="dd/MM/yyyy" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <VerticalStackLayout>
                    <Label Text="Début" FontAttributes="Bold" />
                    <TimePicker Time="{Binding HeureDebut}" Format="HH:mm" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Fin" FontAttributes="Bold" />
                    <TimePicker Time="{Binding HeureFin}" Format="HH:mm" />
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout Spacing="12">
                <Label Text="{Binding Participants, StringFormat='Participants : {0:F0}'}"
                       VerticalOptions="Center" FontAttributes="Bold" />
                <Stepper Minimum="1" Maximum="100" Increment="1" Value="{Binding Participants}" />
            </HorizontalStackLayout>

            <Label Text="Enregistrer s'active quand l'objet compte au moins 3 caractères et que la fin est après le début."
                   FontSize="12" TextColor="{StaticResource RsTexteSecondaire}" />

            <!-- Message de l'API : capacité dépassée (400), créneau déjà pris (409)… -->
            <Label Text="{Binding Message}" TextColor="{StaticResource RsErreur}" />

            <Button Text="Enregistrer" Command="{Binding EnregistrerCommand}" />
            <ActivityIndicator IsRunning="{Binding EstOccupe}" IsVisible="{Binding EstOccupe}"
                               Color="{StaticResource RsPrimaire}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
